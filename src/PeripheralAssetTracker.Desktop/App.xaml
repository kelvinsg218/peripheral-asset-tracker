<Application x:Class="PeripheralAssetTracker.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:PeripheralAssetTracker.Desktop.Views"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <v:BoolToVisibilityConverter x:Key="BoolToVis" />
            <v:EnumEqualsConverter x:Key="EnumEquals" />
            <v:SeverityBrushConverter x:Key="SeverityBrush" />
            <v:PresenceBrushConverter x:Key="PresenceBrush" />
            <v:CountToVisibilityConverter x:Key="CountToVis" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
