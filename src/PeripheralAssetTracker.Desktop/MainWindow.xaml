<Window x:Class="PeripheralAssetTracker.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:PeripheralAssetTracker.Desktop.Views"
        Title="Peripheral Asset Tracker"
        Width="1320" Height="820" MinWidth="880" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/app.ico"
        Background="{StaticResource Brush.Window}"
        Foreground="{StaticResource Brush.Text}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13"
        UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="NavLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="14,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Visibility" Value="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVis}}" />
        </Style>
        <Style x:Key="FadeIn" TargetType="Border">
            <Style.Triggers>
                <Trigger Property="Visibility" Value="Visible">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== Sidebar ===== -->
        <Border Background="{StaticResource Brush.Sidebar}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,1,0">
            <DockPanel Margin="12,18,12,14">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0,0,26">
                    <Image Source="Assets/app.ico" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center"
                                Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Peripheral Asset Tracker" FontWeight="SemiBold" FontSize="13.5" />
                        <TextBlock Text="Inventário de periféricos" Style="{StaticResource Text.Label}" />
                    </StackPanel>
                </StackPanel>

                <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Padding="12"
                        Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="ESTE COMPUTADOR" Style="{StaticResource Text.Label}" FontSize="10.5" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Hostname}" FontWeight="SemiBold" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Hostname}" />
                        <TextBlock Text="{Binding WindowsVersion}" Style="{StaticResource Text.Label}" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding WindowsVersion}" />
                        <Border Height="1" Background="{StaticResource Brush.Border}" Margin="0,10" />
                        <TextBlock Text="Última verificação" Style="{StaticResource Text.Label}" />
                        <TextBlock Text="{Binding LastScanText}" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <StackPanel>
                    <RadioButton Style="{StaticResource Nav}" ToolTip="Painel" AutomationProperties.Name="Painel"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource EnumEquals}, ConverterParameter=Dashboard}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE80F;" />
                            <TextBlock Style="{StaticResource NavLabel}" Text="Painel" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource Nav}" ToolTip="Verificar dispositivos" AutomationProperties.Name="Verificar dispositivos"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource EnumEquals}, ConverterParameter=Scan}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE88E;" />
                            <TextBlock Style="{StaticResource NavLabel}" Text="Verificar dispositivos" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource Nav}" ToolTip="Inventário de dispositivos" AutomationProperties.Name="Inventário de dispositivos"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource EnumEquals}, ConverterParameter=Inventory}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8F1;" />
                            <TextBlock Style="{StaticResource NavLabel}" Text="Inventário de dispositivos" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource Nav}" ToolTip="Responsáveis" AutomationProperties.Name="Responsáveis"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource EnumEquals}, ConverterParameter=People}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE716;" />
                            <TextBlock Style="{StaticResource NavLabel}" Text="Responsáveis" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource Nav}" ToolTip="Computadores" AutomationProperties.Name="Computadores"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource EnumEquals}, ConverterParameter=Computers}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE7F4;" />
                            <TextBlock Style="{StaticResource NavLabel}" Text="Computadores" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource Nav}" ToolTip="Histórico" AutomationProperties.Name="Histórico"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource EnumEquals}, ConverterParameter=History}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE81C;" />
                            <TextBlock Style="{StaticResource NavLabel}" Text="Histórico" />
                        </StackPanel>
                    </RadioButton>
                    <Border Height="1" Background="{StaticResource Brush.Border}" Margin="8,10" />
                    <RadioButton Style="{StaticResource Nav}" ToolTip="Sobre e privacidade" AutomationProperties.Name="Sobre e privacidade"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource EnumEquals}, ConverterParameter=About}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE72E;" />
                            <TextBlock Style="{StaticResource NavLabel}" Text="Sobre e privacidade" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== Content ===== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Background="{StaticResource Brush.YellowSoft}" Padding="32,8"
                    Visibility="{Binding IsSimulation, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="13" Foreground="{StaticResource Brush.Yellow}" />
                    <TextBlock Text="{Binding SimulationText}" Margin="10,0,0,0" Foreground="{StaticResource Brush.Yellow}" />
                </StackPanel>
            </Border>

            <Grid Grid.Row="1" Margin="32,26,32,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding PageTitle}" Style="{StaticResource Text.H1}" />
                    <TextBlock Text="{Binding PageSubtitle}" Style="{StaticResource Text.Subtitle}" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock Text="{Binding BusyText}" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,0,14,0"
                               Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                    <Button Style="{StaticResource Button.Primary}" Command="{Binding ScanCommand}" AutomationProperties.Name="Verificar dispositivos"
                            ToolTip="Consulta o Windows e atualiza quais periféricos estão conectados a este computador.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="13" />
                            <TextBlock Text="Verificar dispositivos" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <ProgressBar Grid.Row="1" VerticalAlignment="Top" IsIndeterminate="{Binding IsBusy}"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

            <Grid x:Name="PageHost" Grid.Row="2" Margin="32,0,32,24">
                <Grid.RenderTransform>
                    <TranslateTransform />
                </Grid.RenderTransform>
                <v:DashboardView Visibility="{Binding CurrentPage, Converter={StaticResource EnumEquals}, ConverterParameter=Dashboard}" />
                <v:ScanView Visibility="{Binding CurrentPage, Converter={StaticResource EnumEquals}, ConverterParameter=Scan}" />
                <v:InventoryView Visibility="{Binding CurrentPage, Converter={StaticResource EnumEquals}, ConverterParameter=Inventory}" />
                <v:PeopleView Visibility="{Binding CurrentPage, Converter={StaticResource EnumEquals}, ConverterParameter=People}" />
                <v:ComputersView Visibility="{Binding CurrentPage, Converter={StaticResource EnumEquals}, ConverterParameter=Computers}" />
                <v:HistoryView Visibility="{Binding CurrentPage, Converter={StaticResource EnumEquals}, ConverterParameter=History}" />
                <v:AboutView Visibility="{Binding CurrentPage, Converter={StaticResource EnumEquals}, ConverterParameter=About}" />
            </Grid>

            <!-- Notification -->
            <Border Grid.Row="2" Style="{StaticResource FadeIn}" VerticalAlignment="Bottom" HorizontalAlignment="Right"
                    Margin="0,0,40,36" MaxWidth="560" Padding="14,11" CornerRadius="8" BorderThickness="1"
                    Background="{StaticResource Brush.Elevated}"
                    BorderBrush="{Binding NoticeSeverity, Converter={StaticResource SeverityBrush}}"
                    Visibility="{Binding IsNoticeVisible, Converter={StaticResource BoolToVis}}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.5" Color="Black" />
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Icon}" FontSize="14" VerticalAlignment="Top" Margin="0,1,0,0"
                               Foreground="{Binding NoticeSeverity, Converter={StaticResource SeverityBrush}}">
                        <TextBlock.Text>
                            <Binding Path="NoticeSeverity">
                                <Binding.Converter>
                                    <v:SeverityGlyphConverter />
                                </Binding.Converter>
                            </Binding>
                        </TextBlock.Text>
                    </TextBlock>
                    <TextBlock Grid.Column="1" Text="{Binding NoticeText}" TextWrapping="Wrap" Margin="10,0,12,0" />
                    <Button Grid.Column="2" Command="{Binding DismissNoticeCommand}" Padding="4" Background="Transparent"
                            BorderThickness="0" VerticalAlignment="Top" ToolTip="Fechar" AutomationProperties.Name="Fechar notificação">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="10" Foreground="{StaticResource Brush.TextSecondary}" />
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <!-- ===== Startup overlay ===== -->
        <Grid Grid.ColumnSpan="2" Background="{StaticResource Brush.Window}"
              Visibility="{Binding IsReady, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560">
                <Image Source="Assets/app.ico" Width="64" Height="64" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="Peripheral Asset Tracker" Style="{StaticResource Text.H1}" HorizontalAlignment="Center" Margin="0,18,0,0" />
                <StackPanel Visibility="{Binding IsStarting, Converter={StaticResource BoolToVis}}" Margin="0,14,0,0">
                    <TextBlock Text="Preparando o inventário…" Style="{StaticResource Text.Subtitle}" HorizontalAlignment="Center" />
                    <ProgressBar IsIndeterminate="True" Width="220" Margin="0,14,0,0" />
                </StackPanel>
                <Border Style="{StaticResource Card}" Margin="0,22,0,0" BorderBrush="{StaticResource Brush.Red}"
                        Visibility="{Binding HasStartupError, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="Não foi possível iniciar" Style="{StaticResource Text.H2}" Foreground="{StaticResource Brush.Red}" />
                        <TextBlock Text="{Binding StartupError}" Style="{StaticResource Text.Value}" Margin="0,8,0,0" />
                        <Button Content="Tentar novamente" Command="{Binding RetryCommand}" HorizontalAlignment="Left" Margin="0,14,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
