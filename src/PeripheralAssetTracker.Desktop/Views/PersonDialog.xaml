<Window x:Class="PeripheralAssetTracker.Desktop.Views.PersonDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Title="Novo responsável"
        Width="440" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Window}" Foreground="{StaticResource Brush.Text}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" UseLayoutRounding="True">
    <StackPanel Margin="26,22,26,24">
        <TextBlock Text="Novo responsável" Style="{StaticResource Text.H2}" FontSize="18" />
        <TextBlock Text="Pessoa que pode receber dispositivos." Style="{StaticResource Text.Subtitle}" Margin="0,4,0,0" />
        <TextBlock Text="Nome" Style="{StaticResource Text.Label}" FontSize="12.5" Margin="0,16,0,6" />
        <TextBox x:Name="NameBox" Tag="Obrigatório" MaxLength="200" />
        <TextBlock Text="Departamento" Style="{StaticResource Text.Label}" FontSize="12.5" Margin="0,16,0,6" />
        <TextBox x:Name="DepartmentBox" Tag="Opcional" MaxLength="200" />
        <TextBlock x:Name="ErrorText" Foreground="{StaticResource Brush.Red}" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Content="Cancelar" IsCancel="True" MinWidth="100" Margin="0,0,8,0" />
            <Button Content="Cadastrar" Style="{StaticResource Button.Primary}" IsDefault="True" MinWidth="110" Click="Confirm_Click" />
        </StackPanel>
    </StackPanel>
</Window>
