<Window x:Class="PeripheralAssetTracker.Desktop.Views.AssignmentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Width="500" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Window}" Foreground="{StaticResource Brush.Text}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Label}">
            <Setter Property="Margin" Value="0,16,0,6" />
            <Setter Property="FontSize" Value="12.5" />
        </Style>
    </Window.Resources>
    <StackPanel Margin="26,22,26,24">
        <TextBlock x:Name="Heading" Style="{StaticResource Text.H2}" FontSize="18" />
        <TextBlock x:Name="DeviceLabel" Style="{StaticResource Text.Subtitle}" Margin="0,4,0,0" />
        <TextBlock x:Name="DetailsText" Style="{StaticResource Text.Label}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed" />

        <StackPanel x:Name="RegisterFields">
            <TextBlock Text="Nome do dispositivo" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="NameBox" Tag="Ex.: Mouse sem fio da recepção" MaxLength="200" />
            <TextBlock Text="Categoria" Style="{StaticResource FieldLabel}" />
            <ComboBox x:Name="TypeBox" />
        </StackPanel>

        <TextBlock x:Name="PersonLabel" Text="Responsável" Style="{StaticResource FieldLabel}" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="PersonBox" AutomationProperties.Name="Responsável" />
            <Button Grid.Column="1" Content="Novo…" Margin="8,0,0,0" Click="NewPerson_Click" ToolTip="Cadastrar um novo responsável" />
        </Grid>

        <TextBlock x:Name="ComputerLabel" Text="Computador esperado" Style="{StaticResource FieldLabel}" />
        <ComboBox x:Name="ComputerBox" AutomationProperties.Name="Computador esperado" />

        <StackPanel x:Name="ReasonFields">
            <TextBlock Text="Motivo da transferência" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="ReasonBox" Tag="Obrigatório. Ex.: troca de setor" MaxLength="500" />
        </StackPanel>

        <TextBlock x:Name="HintText" Style="{StaticResource Text.Label}" FontSize="12" TextWrapping="Wrap" Margin="0,14,0,0" />
        <TextBlock x:Name="ErrorText" Foreground="{StaticResource Brush.Red}" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Content="Cancelar" IsCancel="True" MinWidth="100" Margin="0,0,8,0" />
            <Button x:Name="ConfirmButton" Style="{StaticResource Button.Primary}" IsDefault="True" MinWidth="110" Click="Confirm_Click" />
        </StackPanel>
    </StackPanel>
</Window>
