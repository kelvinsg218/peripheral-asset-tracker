<UserControl x:Class="PeripheralAssetTracker.Desktop.Views.ComputersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource Card}" Padding="0">
        <DataGrid ItemsSource="{Binding Computers}" Margin="1">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Computador" Width="2*" MinWidth="220" SortMemberPath="Hostname">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE7F4;" FontSize="14" Foreground="{StaticResource Brush.TextSecondary}" />
                                <TextBlock Text="{Binding Hostname}" Margin="10,0,0,0" Style="{StaticResource Cell.Text}" />
                                <Border Style="{StaticResource Badge}" Background="{StaticResource Brush.GreenSoft}" Margin="10,0,0,0"
                                        Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Este computador" FontSize="11.5" Foreground="{StaticResource Brush.Green}" />
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Sistema" Binding="{Binding WindowsVersion}" Width="2*" MinWidth="160" ElementStyle="{StaticResource Cell.Muted}" />
                <DataGridTextColumn Header="Primeiro registro" Binding="{Binding FirstSeen}" Width="140" MinWidth="140" ElementStyle="{StaticResource Cell.Muted}" />
                <DataGridTextColumn Header="Última atividade" Binding="{Binding LastSeen}" Width="140" MinWidth="140" ElementStyle="{StaticResource Cell.Muted}" />
                <DataGridTextColumn Header="Dispositivos atribuídos" Binding="{Binding Assigned}" Width="170" MinWidth="170" ElementStyle="{StaticResource Cell.Muted}" />
                <DataGridTextColumn Header="Detectados (30 dias)" Binding="{Binding RecentlyObserved}" Width="160" MinWidth="160" ElementStyle="{StaticResource Cell.Muted}" />
            </DataGrid.Columns>
        </DataGrid>
    </Border>
</UserControl>
