<UserControl x:Class="PeripheralAssetTracker.Desktop.Views.ScanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,12" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox Style="{StaticResource Switch}" Content="Verificação automática" IsChecked="{Binding AutoScan}" Margin="0,0,22,0"
                          ToolTip="Verifica novamente quando o Windows informa que um dispositivo foi conectado ou removido. Funciona apenas com o aplicativo aberto." />
                <CheckBox Style="{StaticResource Switch}" Content="Mostrar integrados" IsChecked="{Binding ShowBuiltIn}"
                          ToolTip="Exibe partes do próprio computador, como o teclado e o touchpad do notebook (ACPI/I2C/PS2)." />
            </StackPanel>
            <TextBlock Text="{Binding ScanSummary}" Style="{StaticResource Text.Subtitle}" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,0,16,0" ToolTip="{Binding ScanSummary}" />
        </DockPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <DataGrid x:Name="ScanGrid" ItemsSource="{Binding ScanView}" Margin="1" SizeChanged="ScanGrid_SizeChanged">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Situação" Width="112" MinWidth="112" SortMemberPath="StatusLabel">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border>
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource Badge}">
                                                <Setter Property="Background" Value="{StaticResource Brush.YellowSoft}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRegistered}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource Brush.GreenSoft}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding StatusLabel}" FontSize="12" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource Brush.Yellow}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRegistered}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource Brush.Green}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Dispositivo" Binding="{Binding Name}" Width="2*" MinWidth="170"
                                            ElementStyle="{StaticResource Cell.Text}" />
                        <DataGridTextColumn Header="Categoria" Binding="{Binding TypeLabel}" Width="100" MinWidth="100" ElementStyle="{StaticResource Cell.Muted}" />
                        <DataGridTextColumn x:Name="ManufacturerColumn" Header="Fabricante" Binding="{Binding Manufacturer}" Width="*" MinWidth="100" ElementStyle="{StaticResource Cell.Muted}" />
                        <DataGridTextColumn x:Name="ModelColumn" Header="VID:PID" Binding="{Binding Model}" Width="100" MinWidth="100" ElementStyle="{StaticResource Cell.Muted}" />
                        <DataGridTextColumn x:Name="BusColumn" Header="Conexão" Binding="{Binding Bus}" Width="120" MinWidth="120" ElementStyle="{StaticResource Cell.Muted}" />
                        <DataGridTextColumn x:Name="ConfidenceColumn" Header="Confiança" Binding="{Binding ConfidenceLabel}" Width="90" MinWidth="90" ElementStyle="{StaticResource Cell.Muted}" />
                        <DataGridTemplateColumn Header="Alertas" Width="*" MinWidth="120" SortMemberPath="AlertsText">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding AlertsText}" ToolTip="{Binding AlertsText}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Cell.Muted}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasAlerts}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource Brush.Yellow}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Ação" Width="150" MinWidth="150" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Button Style="{StaticResource Button.Small}" HorizontalAlignment="Left" Content="Cadastrar"
                                                Command="{Binding DataContext.RegisterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding IsRegistered, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                                        <Button Style="{StaticResource Button.Small}" HorizontalAlignment="Left" Content="Ver no inventário"
                                                Command="{Binding DataContext.ShowInInventoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding IsRegistered, Converter={StaticResource BoolToVis}}" />
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24"
                            Visibility="{Binding HasItems, ElementName=ScanGrid, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE88E;" FontSize="30" HorizontalAlignment="Center"
                               Foreground="{StaticResource Brush.TextMuted}" />
                    <TextBlock Text="Nenhum periférico detectado" Style="{StaticResource Text.H2}" HorizontalAlignment="Center" Margin="0,12,0,0" />
                    <TextBlock Text="Conecte um mouse, teclado ou outro periférico e clique em &quot;Verificar dispositivos&quot;."
                               Style="{StaticResource Text.Subtitle}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
