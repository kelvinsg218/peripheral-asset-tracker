<UserControl x:Class="PeripheralAssetTracker.Desktop.Views.PeopleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Primary}" Command="{Binding AddPersonCommand}" AutomationProperties.Name="Novo responsável">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="12" />
                    <TextBlock Text="Novo responsável" Margin="8,0,0,0" />
                </StackPanel>
            </Button>
            <TextBlock Style="{StaticResource Text.Subtitle}" VerticalAlignment="Center" Margin="0,0,16,0"
                       Text="Os responsáveis são escolhidos ao cadastrar, atribuir ou transferir um dispositivo." />
        </DockPanel>
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <DataGrid x:Name="PeopleGrid" ItemsSource="{Binding People}" Margin="1">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nome" Binding="{Binding Name}" Width="2*" MinWidth="180" ElementStyle="{StaticResource Cell.Text}" />
                        <DataGridTextColumn Header="Departamento" Binding="{Binding Department}" Width="*" MinWidth="140" ElementStyle="{StaticResource Cell.Muted}" />
                        <DataGridTextColumn Header="Dispositivos ativos" Binding="{Binding ActiveDevices}" Width="150" MinWidth="150" ElementStyle="{StaticResource Cell.Muted}" />
                        <DataGridTextColumn Header="Cadastrado em" Binding="{Binding CreatedAt}" Width="150" MinWidth="150" ElementStyle="{StaticResource Cell.Muted}" />
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24"
                            Visibility="{Binding HasItems, ElementName=PeopleGrid, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE716;" FontSize="30" HorizontalAlignment="Center" Foreground="{StaticResource Brush.TextMuted}" />
                    <TextBlock Text="Nenhum responsável cadastrado" Style="{StaticResource Text.H2}" HorizontalAlignment="Center" Margin="0,12,0,0" />
                    <TextBlock Text="Cadastre as pessoas que recebem os periféricos." Style="{StaticResource Text.Subtitle}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
