<UserControl x:Class="PeripheralAssetTracker.Desktop.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="3*" MinHeight="180" />
            <RowDefinition Height="2*" MinHeight="140" />
        </Grid.RowDefinitions>
        <Border Style="{StaticResource Card}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Margin="18,16,18,10">
                    <TextBlock Text="Movimentações registradas" Style="{StaticResource Text.H2}" />
                    <TextBlock Text="Atribuições e transferências oficiais, das mais recentes para as mais antigas." Style="{StaticResource Text.Label}" Margin="0,2,0,0" />
                </StackPanel>
                <DataGrid x:Name="MovementsGrid" Grid.Row="1" ItemsSource="{Binding Movements}" Margin="1,0,1,1">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Data" Binding="{Binding When}" Width="130" MinWidth="130" ElementStyle="{StaticResource Cell.Muted}" />
                        <DataGridTextColumn Header="Tipo" Binding="{Binding Kind}" Width="120" MinWidth="120" ElementStyle="{StaticResource Cell.Text}" />
                        <DataGridTextColumn Header="Dispositivo" Binding="{Binding Device}" Width="*" MinWidth="150" ElementStyle="{StaticResource Cell.Text}" />
                        <DataGridTextColumn Header="De" Binding="{Binding From}" Width="*" MinWidth="140" ElementStyle="{StaticResource Cell.Muted}" />
                        <DataGridTextColumn Header="Para" Binding="{Binding To}" Width="*" MinWidth="140" ElementStyle="{StaticResource Cell.Muted}" />
                        <DataGridTextColumn Header="Motivo" Binding="{Binding Reason}" Width="*" MinWidth="140" ElementStyle="{StaticResource Cell.Muted}" />
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Grid.Row="1" Text="Nenhuma movimentação registrada." Style="{StaticResource Text.Subtitle}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding HasItems, ElementName=MovementsGrid, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
            </Grid>
        </Border>
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,12,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <TextBlock Text="Atividade desta sessão" Style="{StaticResource Text.H2}" />
                    <TextBlock Text="Conexões e desconexões percebidas entre verificações enquanto o aplicativo está aberto. Esta lista não é gravada no banco."
                               Style="{StaticResource Text.Label}" TextWrapping="Wrap" Margin="0,2,0,0" />
                </StackPanel>
                <Grid>
                    <TextBlock Text="Nenhuma atividade nesta sessão." Style="{StaticResource Text.Label}"
                               Visibility="{Binding Activity.Count, Converter={StaticResource CountToVis}, ConverterParameter=Zero}" />
                    <ItemsControl ItemsSource="{Binding Activity}">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Time}" Style="{StaticResource Text.Label}" FontFamily="{StaticResource Font.Mono}" FontSize="12" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="12"
                                               Foreground="{Binding Severity, Converter={StaticResource SeverityBrush}}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Text}" TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
